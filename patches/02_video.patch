+    @Test
+    public void testTorrServePlaylistParsing() throws IOException {
+        M3uParser.Result result = parse("#EXTM3U\n" +
+                "#EXTINF:-1,Breaking Bad - s01e01 - Pilot\n" +
+                "http://127.0.0.1:8090/stream/link1.mkv?play\n" +
+                "#EXTINF:-1,Breaking Bad - s01e02 - Cat's in the Bag...\n" +
+                "http://127.0.0.1:8090/stream/link2.mkv?play\n", null);
+
+        assertFalse(result.isHls);
+        assertEquals(2, result.items.size());
+        assertEquals("http://127.0.0.1:8090/stream/link1.mkv?play", result.items.get(0).url);
+        assertEquals("Breaking Bad - s01e01 - Pilot", result.items.get(0).title);
+        assertEquals("Breaking Bad - s01e02 - Cat's in the Bag...", result.items.get(1).title);
+    }
