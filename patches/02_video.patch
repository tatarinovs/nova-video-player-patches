+package com.archos.mediacenter.video.player;
+
+import com.archos.mediaprovider.video.VideoStore;
+
+/**
+ * Short resolution label ("4K", "1080p"...) shown next to the title in the OSD.
+ */
+final class VideoQualityBadge {
+
+    // FFmpeg AVColorTransferCharacteristic values of HDR transfer functions
+    private static final int TRC_SMPTE2084_PQ = 16;
+    private static final int TRC_ARIB_STD_B67_HLG = 18;
+
+    private VideoQualityBadge() {
+    }
+
+    /**
+     * Label from the decoded frame size. Both dimensions are considered so that cropped
+     * (scope, 1920x800) and portrait videos get the label of their source resolution.
+     *
+     * @return the label, or null when the size is unknown
+     */
+    static String fromSize(int width, int height) {
+        if (width <= 0 || height <= 0) return null;
+        int max = Math.max(width, height);
+        int min = Math.min(width, height);
+        if (max >= 3800 || min >= 2000) return "4K";
+        if (max >= 2500 || min >= 1400) return "1440p";
+        if (max >= 1700 || min >= 1000) return "1080p";
+        if (max >= 1200 || min >= 700) return "720p";
+        if (max >= 700 || min >= 450) return "480p";
+        return "SD";
+    }
+
+    /** Label from the media library definition column, or null. */
+    static String fromDefinition(int definition) {
+        switch (definition) {
+            case VideoStore.Video.VideoColumns.ARCHOS_DEFINITION_4K: return "4K";
+            case VideoStore.Video.VideoColumns.ARCHOS_DEFINITION_1080P: return "1080p";
+            case VideoStore.Video.VideoColumns.ARCHOS_DEFINITION_720P: return "720p";
+            case VideoStore.Video.VideoColumns.ARCHOS_DEFINITION_SD: return "SD";
+            default: return null;
+        }
+    }
+
+    /** Appends " HDR" for PQ (HDR10/HDR10+/Dolby Vision base layer) and HLG transfers. */
+    static String withHdr(String badge, int colorTrc) {
+        if (badge == null) return null;
+        return colorTrc == TRC_SMPTE2084_PQ || colorTrc == TRC_ARIB_STD_B67_HLG ? badge + " HDR" : badge;
+    }
+}
