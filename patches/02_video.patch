+package com.archos.mediacenter.video.player;
+
+import android.animation.TimeAnimator;
+import android.content.SharedPreferences;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.TypedValue;
+import android.view.KeyEvent;
+import android.view.View;
+
+import java.util.Random;
+
+/**
+ * Dims the screen after a period of inactivity while the video is paused and shows a clock
+ * which keeps moving across the screen, bouncing off its edges, to protect OLED panels from
+ * burn-in. Any key or touch wakes it up.
+ */
+final class PauseScreensaver {
+
+    interface Host {
+        boolean isVideoPaused();
+
+        /** Called when the screensaver appears, e.g. to hide the OSD. */
+        void onScreensaverShown();
+    }
+
+    static final String KEY_TIMEOUT_MINUTES = "screensaver_pause_timeout";
+    private static final String DEFAULT_TIMEOUT_MINUTES = "10";
+
+    private static final long FADE_IN_MS = 800;
+    private static final long FADE_OUT_MS = 300;
+    private static final float SPEED_DP_PER_S = 75;
+    private static final float MARGIN_DP = 24;
+    // Frames after a stall (e.g. app resumed) must not teleport the clock
+    private static final long MAX_FRAME_DELTA_MS = 100;
+
+    private final View mOverlay;
+    private final View mClock;
+    private final SharedPreferences mPreferences;
+    private final Host mHost;
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final Random mRandom = new Random();
+    private final Runnable mShowRunnable = this::show;
+    private final TimeAnimator mBounceAnimator = new TimeAnimator();
+    private final float mMargin;
+    private float mVelocityX; // px/s, relative to the centered position
+    private float mVelocityY;
+    private boolean mActive;
+
+    PauseScreensaver(View overlay, View clock, SharedPreferences preferences, Host host) {
+        mOverlay = overlay;
+        mClock = clock;
+        mPreferences = preferences;
+        mHost = host;
+        mMargin = TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, MARGIN_DP,
+                overlay.getResources().getDisplayMetrics());
+        mBounceAnimator.setTimeListener((animation, totalTime, deltaTime) -> moveClock(deltaTime));
+    }
+
+    boolean isActive() {
+        return mActive;
+    }
+
+    /** (Re)arms the inactivity timer when the video is paused. */
+    void restartTimer() {
+        mHandler.removeCallbacks(mShowRunnable);
+        long timeout = getTimeoutMillis();
+        if (timeout > 0 && mHost.isVideoPaused()) {
+            mHandler.postDelayed(mShowRunnable, timeout);
+        }
+    }
+
+    /** User interaction: leaves the screensaver and restarts the inactivity timer. */
+    void onUserActivity() {
+        hide(true);
+        restartTimer();
+    }
+
+    /** Playback resumed or the player went to background. */
+    void stop() {
+        mHandler.removeCallbacks(mShowRunnable);
+        hide(false);
+    }
+
+    /**
+     * Keys which keep their function while the screensaver is shown (they also wake it up):
+     * the volume must stay adjustable and "play" must not need a second press.
+     */
+    static boolean isPassThroughKey(int keyCode) {
+        switch (keyCode) {
+            case KeyEvent.KEYCODE_VOLUME_UP:
+            case KeyEvent.KEYCODE_VOLUME_DOWN:
+            case KeyEvent.KEYCODE_VOLUME_MUTE:
+            case KeyEvent.KEYCODE_MEDIA_PLAY:
+            case KeyEvent.KEYCODE_MEDIA_PLAY_PAUSE:
+            case KeyEvent.KEYCODE_HEADSETHOOK:
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    private long getTimeoutMillis() {
+        try {
+            return Integer.parseInt(mPreferences.getString(KEY_TIMEOUT_MINUTES, DEFAULT_TIMEOUT_MINUTES)) * 60_000L;
+        } catch (NumberFormatException e) {
+            return Integer.parseInt(DEFAULT_TIMEOUT_MINUTES) * 60_000L;
+        }
+    }
+
+    private void show() {
+        if (mActive || !mHost.isVideoPaused()) return;
+        mActive = true;
+        mHost.onScreensaverShown();
+        mClock.setTranslationX(0f);
+        mClock.setTranslationY(0f);
+        mOverlay.animate().cancel();
+        mOverlay.setAlpha(0f);
+        mOverlay.setVisibility(View.VISIBLE);
+        mOverlay.animate().alpha(1f).setDuration(FADE_IN_MS).start();
+        startBounce();
+    }
+
+    private void startBounce() {
+        float speed = TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, SPEED_DP_PER_S,
+                mOverlay.getResources().getDisplayMetrics());
+        // Diagonal direction between 30° and 60° so that the clock sweeps the whole screen
+        double angle = Math.toRadians(30 + mRandom.nextInt(31));
+        mVelocityX = (mRandom.nextBoolean() ? 1f : -1f) * speed * (float) Math.cos(angle);
+        mVelocityY = (mRandom.nextBoolean() ? 1f : -1f) * speed * (float) Math.sin(angle);
+        mBounceAnimator.start();
+    }
+
+    private void moveClock(long deltaMs) {
+        if (!mActive) {
+            mBounceAnimator.cancel();
+            return;
+        }
+        // The clock is centered in the overlay: its translation ranges over [-range, +range]
+        float rangeX = Math.max(0f, (mOverlay.getWidth() - mClock.getWidth()) / 2f - mMargin);
+        float rangeY = Math.max(0f, (mOverlay.getHeight() - mClock.getHeight()) / 2f - mMargin);
+        if (rangeX <= 0f || rangeY <= 0f) return; // not laid out yet
+
+        float dt = Math.min(deltaMs, MAX_FRAME_DELTA_MS) / 1000f;
+        float x = mClock.getTranslationX() + mVelocityX * dt;
+        float y = mClock.getTranslationY() + mVelocityY * dt;
+
+        // Reflect on the edges (mirroring the overshoot keeps the speed constant)
+        if (x > rangeX) {
+            x = 2 * rangeX - x;
+            mVelocityX = -Math.abs(mVelocityX);
+        } else if (x < -rangeX) {
+            x = -2 * rangeX - x;
+            mVelocityX = Math.abs(mVelocityX);
+        }
+        if (y > rangeY) {
+            y = 2 * rangeY - y;
+            mVelocityY = -Math.abs(mVelocityY);
+        } else if (y < -rangeY) {
+            y = -2 * rangeY - y;
+            mVelocityY = Math.abs(mVelocityY);
+        }
+
+        mClock.setTranslationX(Math.max(-rangeX, Math.min(rangeX, x)));
+        mClock.setTranslationY(Math.max(-rangeY, Math.min(rangeY, y)));
+    }
+
+    private void hide(boolean animated) {
+        mBounceAnimator.cancel();
+        if (!mActive) return;
+        mActive = false;
+        mOverlay.animate().cancel();
+        if (animated) {
+            mOverlay.animate()
+                    .alpha(0f)
+                    .setDuration(FADE_OUT_MS)
+                    .withEndAction(() -> {
+                        if (!mActive) mOverlay.setVisibility(View.GONE);
+                    })
+                    .start();
+        } else {
+            mOverlay.setAlpha(0f);
+            mOverlay.setVisibility(View.GONE);
+        }
+    }
+}
