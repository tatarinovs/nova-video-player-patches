+package com.archos.mediacenter.video.player;
+
+import android.content.Context;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+
+import com.archos.mediacenter.filecoreextension.upnp2.FileEditorFactoryWithUpnp;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FilterInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.ByteBuffer;
+import java.nio.charset.CharacterCodingException;
+import java.nio.charset.Charset;
+import java.nio.charset.CodingErrorAction;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Parser for simple M3U/M3U8 playlists (lists of videos). HLS playlists (segments or variant
+ * streams) are detected and reported as such so that they are handed to the player unchanged.
+ */
+public final class M3uParser {
+
+    private static final Logger log = LoggerFactory.getLogger(M3uParser.class);
+
+    /** Video playlists are small; anything bigger is not a playlist we want to hold in memory. */
+    private static final int MAX_PLAYLIST_BYTES = 4 * 1024 * 1024;
+    private static final int CONNECT_TIMEOUT_MS = 10_000;
+    private static final int READ_TIMEOUT_MS = 15_000;
+    /** Legacy .m3u files written on Russian systems; tried when the content is not valid UTF-8. */
+    private static final Charset FALLBACK_CHARSET = Charset.forName("windows-1251");
+
+    private static final Pattern URL_SCHEME = Pattern.compile("^[a-zA-Z][a-zA-Z0-9+.-]*://");
+    private static final Pattern URL_ORIGIN = Pattern.compile("^([a-zA-Z][a-zA-Z0-9+.-]*://[^/?#]*)");
+
+    private static final ExecutorService EXECUTOR = Executors.newSingleThreadExecutor(r -> {
+        Thread t = new Thread(r, "M3uParser");
+        t.setDaemon(true);
+        return t;
+    });
+
+    private M3uParser() {
+    }
+
+    public static final class PlaylistItem {
+        public final String url;
+        public final String title;
+
+        public PlaylistItem(String url, String title) {
+            this.url = url;
+            this.title = title;
+        }
+
+        public Uri getUri() {
+            return url != null ? Uri.parse(url) : null;
+        }
+
+        @Override
+        public String toString() {
+            return "PlaylistItem{title='" + title + "', url='" + url + "'}";
+        }
+    }
+
+    public static final class Result {
+        public final List<PlaylistItem> items;
+        public final boolean isHls;
+
+        public Result(List<PlaylistItem> items, boolean isHls) {
+            this.items = items != null ? items : new ArrayList<>();
+            this.isHls = isHls;
+        }
+
+        public boolean isEmpty() {
+            return items.isEmpty();
+        }
+    }
+
+    public interface Callback {
+        void onSuccess(Result result);
+
+        void onError(Exception e);
+    }
+
+    /**
+     * Downloads and parses a playlist on a background thread; the callback runs on the main thread.
+     */
+    public static void parseAsync(Context context, Uri uri, Callback callback) {
+        final Context appContext = context != null ? context.getApplicationContext() : null;
+        EXECUTOR.execute(() -> {
+            try {
+                Result result = parse(appContext, uri);
+                new Handler(Looper.getMainLooper()).post(() -> callback.onSuccess(result));
+            } catch (Exception e) {
+                log.warn("parseAsync: cannot read playlist {}", uri, e);
+                new Handler(Looper.getMainLooper()).post(() -> callback.onError(e));
+            }
+        });
+    }
+
+    public static Result parse(Context context, Uri uri) throws IOException {
+        if (uri == null) throw new IOException("No playlist URI");
+        try (InputStream is = openInputStream(context, uri)) {
+            return parse(is, uri.toString());
+        }
+    }
+
+    public static Result parse(InputStream is, String baseUri) throws IOException {
+        return parse(decode(readLimited(is)), baseUri);
+    }
+
+    static Result parse(String content, String baseUri) {
+        List<PlaylistItem> items = new ArrayList<>();
+        String pendingTitle = null;
+        for (String rawLine : content.split("\r\n|\r|\n")) {
+            String line = rawLine.trim();
+            if (line.isEmpty()) continue;
+
+            if (line.startsWith("#EXT-X-")) {
+                // HLS tags (#EXT-X-STREAM-INF, #EXT-X-TARGETDURATION...) make it a stream, not a list
+                if (log.isDebugEnabled()) log.debug("parse: HLS playlist detected ({})", line);
+                return new Result(null, true);
+            }
+            if (line.startsWith("#EXTINF:")) {
+                pendingTitle = extractExtinfTitle(line);
+                continue;
+            }
+            if (line.startsWith("#")) continue; // other directives and comments
+
+            String url = resolveUrl(line, baseUri);
+            String title = pendingTitle != null ? pendingTitle : fileNameOf(url);
+            items.add(new PlaylistItem(url, title));
+            pendingTitle = null;
+        }
+        return new Result(items, false);
+    }
+
+    /**
+     * Resolves a playlist entry against the playlist location: absolute URLs are kept,
+     * root-relative paths stay on the playlist's server, relative ones use its folder.
+     */
+    public static String resolveUrl(String entry, String baseUri) {
+        if (entry == null) return "";
+        entry = entry.trim();
+        if (URL_SCHEME.matcher(entry).find()) return entry;
+
+        if (baseUri == null) {
+            return entry.startsWith("/") ? "file://" + entry : entry;
+        }
+        String base = stripQueryAndFragment(baseUri);
+        if (entry.startsWith("/")) {
+            Matcher origin = URL_ORIGIN.matcher(base);
+            boolean remote = origin.find() && !base.regionMatches(true, 0, "file:", 0, 5);
+            return remote ? origin.group(1) + entry : "file://" + entry;
+        }
+        int lastSlash = base.lastIndexOf('/');
+        return lastSlash >= 0 ? base.substring(0, lastSlash + 1) + entry : entry;
+    }
+
+    /** "#EXTINF:<duration> [key="value, with comma"...],<title>": the first comma outside quotes. */
+    static String extractExtinfTitle(String extinfLine) {
+        boolean inQuotes = false;
+        for (int i = "#EXTINF:".length(); i < extinfLine.length(); i++) {
+            char c = extinfLine.charAt(i);
+            if (c == '"') {
+                inQuotes = !inQuotes;
+            } else if (c == ',' && !inQuotes) {
+                String title = extinfLine.substring(i + 1).trim();
+                return title.isEmpty() ? null : title;
+            }
+        }
+        return null;
+    }
+
+    private static String fileNameOf(String url) {
+        String path = stripQueryAndFragment(url);
+        String name = path.substring(path.lastIndexOf('/') + 1);
+        return Uri.decode(name);
+    }
+
+    private static String stripQueryAndFragment(String url) {
+        int end = url.length();
+        int q = url.indexOf('?');
+        if (q >= 0) end = q;
+        int hash = url.indexOf('#');
+        if (hash >= 0 && hash < end) end = hash;
+        return url.substring(0, end);
+    }
+
+    private static byte[] readLimited(InputStream is) throws IOException {
+        if (is == null) throw new IOException("No playlist stream");
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        byte[] buffer = new byte[16 * 1024];
+        int n;
+        while ((n = is.read(buffer)) != -1) {
+            if (out.size() + n > MAX_PLAYLIST_BYTES) {
+                throw new IOException("Playlist larger than " + MAX_PLAYLIST_BYTES + " bytes");
+            }
+            out.write(buffer, 0, n);
+        }
+        return out.toByteArray();
+    }
+
+    /** UTF-8 (with or without BOM) when valid, windows-1251 otherwise. */
+    static String decode(byte[] bytes) {
+        int offset = 0;
+        if (bytes.length >= 3 && (bytes[0] & 0xFF) == 0xEF && (bytes[1] & 0xFF) == 0xBB && (bytes[2] & 0xFF) == 0xBF) {
+            offset = 3;
+        }
+        ByteBuffer data = ByteBuffer.wrap(bytes, offset, bytes.length - offset);
+        try {
+            return StandardCharsets.UTF_8.newDecoder()
+                    .onMalformedInput(CodingErrorAction.REPORT)
+                    .onUnmappableCharacter(CodingErrorAction.REPORT)
+                    .decode(data)
+                    .toString();
+        } catch (CharacterCodingException e) {
+            return new String(bytes, offset, bytes.length - offset, FALLBACK_CHARSET);
+        }
+    }
+
+    public static InputStream openInputStream(Context context, Uri uri) throws IOException {
+        String scheme = uri.getScheme() != null ? uri.getScheme().toLowerCase(Locale.ROOT) : "file";
+        switch (scheme) {
+            case "http":
+            case "https":
+                return openHttp(uri);
+            case "content":
+                if (context == null) throw new IOException("Context required to open " + uri);
+                InputStream content = context.getContentResolver().openInputStream(uri);
+                if (content == null) throw new IOException("Cannot open " + uri);
+                return content;
+            case "file":
+                if (uri.getPath() == null) throw new IOException("Invalid file uri " + uri);
+                return new FileInputStream(new File(uri.getPath()));
+            default:
+                // smb, sftp, webdav, upnp...: go through the same backends as the video itself
+                if (context == null) throw new IOException("Context required to open " + uri);
+                try {
+                    return FileEditorFactoryWithUpnp.getFileEditorForUrl(uri, context).getInputStream();
+                } catch (Exception e) {
+                    throw new IOException("Cannot open " + uri, e);
+                }
+        }
+    }
+
+    private static InputStream openHttp(Uri uri) throws IOException {
+        HttpURLConnection conn = (HttpURLConnection) new URL(uri.toString()).openConnection();
+        conn.setConnectTimeout(CONNECT_TIMEOUT_MS);
+        conn.setReadTimeout(READ_TIMEOUT_MS);
+        conn.setInstanceFollowRedirects(true);
+        try {
+            int code = conn.getResponseCode();
+            if (code < 200 || code >= 300) {
+                throw new IOException("HTTP " + code + " for " + uri);
+            }
+            String contentType = conn.getContentType();
+            if (contentType != null && contentType.toLowerCase(Locale.ROOT).startsWith("text/html")) {
+                throw new IOException("Not a playlist (" + contentType + ") at " + uri);
+            }
+            return new FilterInputStream(conn.getInputStream()) {
+                @Override
+                public void close() throws IOException {
+                    try {
+                        super.close();
+                    } finally {
+                        conn.disconnect();
+                    }
+                }
+            };
+        } catch (IOException e) {
+            conn.disconnect();
+            throw e;
+        }
+    }
+}
