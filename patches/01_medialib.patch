+    @Test
+    public void testSplitBilingualTitle() {
+        java.util.List<String> res1 = ParseUtils.splitBilingualTitle("Назад в будущее Back to the Future");
+        assertEquals(2, res1.size());
+        assertEquals("Назад в будущее", res1.get(0));
+        assertEquals("Back to the Future", res1.get(1));
+
+        java.util.List<String> res2 = ParseUtils.splitBilingualTitle("Back to the Future Назад в будущее");
+        assertEquals(2, res2.size());
+        assertEquals("Back to the Future", res2.get(0));
+        assertEquals("Назад в будущее", res2.get(1));
+
+        java.util.List<String> res3 = ParseUtils.splitBilingualTitle("Брат 2 Brother 2");
+        assertEquals(2, res3.size());
+        assertEquals("Брат 2", res3.get(0));
+        assertEquals("Brother 2", res3.get(1));
+
+        java.util.List<String> res4 = ParseUtils.splitBilingualTitle("Назад в будущее / Back to the Future");
+        assertEquals(2, res4.size());
+        assertEquals("Назад в будущее", res4.get(0));
+        assertEquals("Back to the Future", res4.get(1));
+
+        assertTrue(ParseUtils.splitBilingualTitle("Sneakers").isEmpty());
+        assertTrue(ParseUtils.splitBilingualTitle("Назад в будущее").isEmpty());
+    }
