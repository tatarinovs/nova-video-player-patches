+package com.archos.mediacenter.utils.videodb;
+
+import android.net.Uri;
+
+import com.archos.mediascraper.ShowUtils;
+
+import java.util.Locale;
+import java.util.Map;
+import java.util.regex.Pattern;
+
+/**
+ * Title shown for a video stream (TorrServe, AceStream, HTTP playlists...) until it is scraped.
+ *
+ * The title given by the launching application (e.g. the torrent topic) is shown as is; when
+ * the stream's file name identifies an episode ("/stream/Show.S04E07.mkv"), its number is
+ * appended. Once the file name is scraped, the scraped title replaces this one.
+ */
+public final class StreamTitleResolver {
+
+    private static final String EPISODE_SUFFIX = "%s  -  S%02dE%02d";
+    private static final String DEFAULT_TITLE = "Video";
+
+    private static final Pattern VIDEO_EXTENSION = Pattern.compile(
+            "\\.(?:mkv|mp4|m4v|avi|mov|wmv|webm|flv|ts|m2ts|mts|mpg|mpeg|vob|iso|3gp|ogv|divx|rmvb|m3u8?)$",
+            Pattern.CASE_INSENSITIVE);
+
+    // Tags in front of a torrent topic, e.g. TorrServe's category "[NUM] "
+    private static final Pattern LEADING_TAGS = Pattern.compile("^(?:\\[[^\\]]*\\]\\s*)+");
+
+    private static final String[] PLACEHOLDER_NAMES = {"stream", "play", "video", "file", "link", "index"};
+    private static final String[] NAME_QUERY_PARAMETERS = {"fname", "title", "name", "file"};
+
+    public static final class Result {
+        public final String title;      // Title for the OSD, e.g. "<source title>  -  S04E07"
+        public final String showName;   // Source title (or file name) without the episode suffix
+        public final int season;        // -1 when the file name has no episode number
+        public final int episode;       // -1 when the file name has no episode number
+        public final boolean isTvShow;
+
+        Result(String title, String showName, int season, int episode) {
+            this.title = title;
+            this.showName = showName;
+            this.season = season;
+            this.episode = episode;
+            this.isTvShow = episode >= 0;
+        }
+
+        @Override
+        public String toString() {
+            return "Result{title='" + title + "', S=" + season + ", E=" + episode + "}";
+        }
+    }
+
+    private StreamTitleResolver() {
+    }
+
+    /**
+     * @param uri         the stream URI (its file name may carry the episode number)
+     * @param sourceTitle the title passed by the launching application, shown unchanged
+     */
+    public static Result resolve(Uri uri, String sourceTitle) {
+        String fileName = extractFileName(uri);
+        String source = !isBlank(sourceTitle) ? LEADING_TAGS.matcher(sourceTitle.trim()).replaceFirst("") : null;
+        String name = !isBlank(source) ? source : fileName != null ? fileName : DEFAULT_TITLE;
+
+        Map<String, String> parsed = fileName != null ? ShowUtils.parseShowName(fileName) : null;
+        Integer season = parsed != null ? parseInteger(parsed.get(ShowUtils.SEASON)) : null;
+        Integer episode = parsed != null ? parseInteger(parsed.get(ShowUtils.EPNUM)) : null;
+        if (season == null || episode == null) {
+            return new Result(name, name, -1, -1);
+        }
+        String marker = String.format(Locale.ROOT, "S%02dE%02d", season, episode);
+        String title = name.toUpperCase(Locale.ROOT).contains(marker)
+                ? name // the source title already names this episode
+                : String.format(Locale.ROOT, EPISODE_SUFFIX, name, season, episode);
+        return new Result(title, name, season, episode);
+    }
+
+    /**
+     * File name (without video extension) of a stream URI, handling URL encoding, query
+     * parameters and generic endpoints ("/stream?title=..."), or null when there is none.
+     */
+    public static String extractFileName(Uri uri) {
+        if (uri == null) return null;
+
+        String raw = uri.toString();
+        int end = raw.length();
+        int q = raw.indexOf('?');
+        if (q >= 0) end = q;
+        int hash = raw.indexOf('#');
+        if (hash >= 0 && hash < end) end = hash;
+        String pathPart = raw.substring(0, end);
+        while (pathPart.endsWith("/")) {
+            pathPart = pathPart.substring(0, pathPart.length() - 1);
+        }
+
+        // Decode before splitting so that encoded subfolders ("Season%201%2FEpisode.mkv") yield
+        // the file name only
+        String decodedPath = Uri.decode(pathPart);
+        String name = null;
+        if (!isBlank(decodedPath)) {
+            name = stripVideoExtension(decodedPath.substring(decodedPath.lastIndexOf('/') + 1));
+        }
+
+        if (isPlaceholderName(name) && uri.isHierarchical()) {
+            for (String param : NAME_QUERY_PARAMETERS) {
+                String value = uri.getQueryParameter(param); // already decoded
+                if (isBlank(value)) continue;
+                value = stripVideoExtension(value.trim());
+                value = value.substring(value.lastIndexOf('/') + 1);
+                if (!value.isEmpty()) {
+                    name = value;
+                    break;
+                }
+            }
+        }
+
+        return isPlaceholderName(name) ? null : name.trim();
+    }
+
+    private static String stripVideoExtension(String name) {
+        return VIDEO_EXTENSION.matcher(name).replaceFirst("");
+    }
+
+    private static boolean isPlaceholderName(String name) {
+        if (isBlank(name)) return true;
+        for (String placeholder : PLACEHOLDER_NAMES) {
+            if (placeholder.equalsIgnoreCase(name)) return true;
+        }
+        return false;
+    }
+
+    private static Integer parseInteger(String value) {
+        if (value == null) return null;
+        try {
+            return Integer.parseInt(value.trim());
+        } catch (NumberFormatException e) {
+            return null;
+        }
+    }
+
+    private static boolean isBlank(String s) {
+        return s == null || s.trim().isEmpty();
+    }
+}
