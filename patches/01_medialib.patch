+    @Test
+    public void testLeadingNumbering() {
+        assertEquals("Назад.в.будущее", ParseUtils.removeNumbering("01.Назад.в.будущее"));
+        assertEquals("Back.to.the.Future", ParseUtils.removeNumbering("01.Back.to.the.Future"));
+        assertEquals("Toy Story 3", ParseUtils.removeNumbering("100. Toy Story 3"));
+        assertEquals("3.10 to Yuma", ParseUtils.removeNumbering("3.10 to Yuma"));
+        assertEquals("2 Guns", ParseUtils.removeNumbering("2 Guns"));
+        assertEquals("300 (2007)", ParseUtils.removeNumbering("300 (2007)"));
+        // Titles starting with a number glued to a dot are real titles, not a collection index
+        assertEquals("21.Jump.Street.2012", ParseUtils.removeNumbering("21.Jump.Street.2012"));
+        assertEquals("2.Fast.2.Furious", ParseUtils.removeNumbering("2.Fast.2.Furious"));
+        assertEquals("12.Angry.Men", ParseUtils.removeNumbering("12.Angry.Men"));
+        assertEquals("007.Skyfall", ParseUtils.removeNumbering("007.Skyfall"));
+    }
