+        assertEquals(java.util.Arrays.asList("Моя"), TransliterateUtils.transliterateToCyrillicVariants("Moya"));
+        assertEquals(java.util.Arrays.asList("Холоп"), TransliterateUtils.transliterateToCyrillicVariants("Kholop"));
+    }
+
+    @Test
+    public void testTransliteratePopularMoviesAndShows() {
+        // "Kholop" -> "Холоп"
+        assertEquals("Холоп", TransliterateUtils.transliterateToCyrillic("Kholop"));
+
+        // "Brat" -> "Брат", "Brat 2" -> "Брат 2"
+        assertEquals("Брат", TransliterateUtils.transliterateToCyrillic("Brat"));
+        assertEquals("Брат 2", TransliterateUtils.transliterateToCyrillic("Brat 2"));
+
+        // "Brigada" -> "Бригада"
+        assertEquals("Бригада", TransliterateUtils.transliterateToCyrillic("Brigada"));
+
+        // "Zhmurki" -> "Жмурки"
+        assertEquals("Жмурки", TransliterateUtils.transliterateToCyrillic("Zhmurki"));
+
+        // "Bumer" -> "Бумер"
+        assertEquals("Бумер", TransliterateUtils.transliterateToCyrillic("Bumer"));
+
+        // "Kukhnya" -> "Кухня"
+        assertEquals("Кухня", TransliterateUtils.transliterateToCyrillic("Kukhnya"));
+
+        // "Interny" -> "Интерны"
+        assertEquals("Интерны", TransliterateUtils.transliterateToCyrillic("Interny"));
+
+        // "Metod" -> "Метод"
+        assertEquals("Метод", TransliterateUtils.transliterateToCyrillic("Metod"));
+
+        // "DMB" -> "ДМБ"
+        assertEquals("ДМБ", TransliterateUtils.transliterateToCyrillic("DMB"));
+
+        // "Operatsiya Y" -> "Операция Ы"
+        assertEquals("Операция Ы", TransliterateUtils.transliterateToCyrillic("Operatsiya Y"));
+
+        // "Operaciya Y" -> "Операция Ы" (using 'c' for 'ц')
+        assertEquals("Операция Ы", TransliterateUtils.transliterateToCyrillic("Operaciya Y"));
+
+        // "Shchuka" -> "Щука"
+        assertEquals("Щука", TransliterateUtils.transliterateToCyrillic("Shchuka"));
