+package com.archos.mediascraper.preprocess;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Reverse transliteration of Russian titles written with Latin letters ("Kholop" -> "Холоп").
+ *
+ * The mapping follows the common BGN/PCGN-like conventions used by release names, with
+ * context rules for the ambiguous letters:
+ * <ul>
+ *   <li>{@code y}/{@code j} before a vowel is iotation ("ya" -> "я", "Moya" -> "Моя");</li>
+ *   <li>{@code y} after a vowel is "й" ("Viy" -> "Вий"), otherwise "ы" ("Menty" -> "Менты");</li>
+ *   <li>{@code e} at the start of a word is "э" ("Ekipazh" -> "Экипаж");</li>
+ *   <li>{@code c} before e/i/y is "ц", otherwise "к";</li>
+ *   <li>word-final "ia"/"ii" is "ия"/"ий" ("Maria" -> "Мария").</li>
+ * </ul>
+ * Only these general rules are applied: no word-specific exceptions and no guesses at
+ * misspellings. What the Latin spelling cannot tell apart ("ts" is "ц" or "тс", a soft sign
+ * inside a word is usually dropped) is left to the fuzzy TMDb search and to the scoring of the
+ * results, so the result is only a search candidate.
+ */
+public final class TransliterateUtils {
+
+    private static final Pattern WORD_OR_SEPARATOR = Pattern.compile("([\\p{L}']+)|([^\\p{L}']+)");
+
+    private TransliterateUtils() {
+        // Utility class
+    }
+
+    /**
+     * Checks whether the given language tag or, when absent, the default system locale is Russian.
+     */
+    public static boolean isRussianLanguage(String language) {
+        if (language != null && !language.isEmpty()) {
+            return language.toLowerCase(Locale.ROOT).startsWith("ru");
+        }
+        return "ru".equalsIgnoreCase(Locale.getDefault().getLanguage());
+    }
+
+    /**
+     * Translates transliterated Russian text (Latin characters) into Cyrillic.
+     * Preserves capitalization (e.g. "Kholop" -> "Холоп", "BRAT" -> "БРАТ", "brat" -> "брат").
+     * Leaves numbers, punctuation and non-Latin characters untouched.
+     */
+    public static String transliterateToCyrillic(String input) {
+        return transliterate(input, false);
+    }
+
+    /**
+     * The transliteration of {@link #transliterateToCyrillic}, followed, when it differs, by the
+     * one with a soft sign before an iotated vowel following a consonant: release names drop it
+     * ("Druzja" is "Друзья", while "Kolya" is "Коля").
+     */
+    public static List<String> transliterateToCyrillicVariants(String input) {
+        List<String> variants = new ArrayList<>(2);
+        String plain = transliterate(input, false);
+        if (plain == null || plain.isEmpty()) return variants;
+        variants.add(plain);
+        String softSign = transliterate(input, true);
+        if (!softSign.equals(plain)) variants.add(softSign);
+        return variants;
+    }
+
+    private static String transliterate(String input, boolean softSign) {
+        if (input == null || input.isEmpty()) {
+            return input;
+        }
+
+        // Typographic apostrophes are soft signs as well
+        String normalized = input.replace('’', '\'').replace('‘', '\'');
+
+        StringBuilder result = new StringBuilder(normalized.length());
+        Matcher matcher = WORD_OR_SEPARATOR.matcher(normalized);
+        while (matcher.find()) {
+            String word = matcher.group(1);
+            result.append(word != null ? transliterateWord(word, softSign) : matcher.group(2));
+        }
+        return result.toString();
+    }
+
+    private static String transliterateWord(String word, boolean softSign) {
+        boolean allUpper = isAllUpperCase(word);
+        boolean firstUpper = Character.isUpperCase(word.charAt(0));
+
+        String lower = word.toLowerCase(Locale.ROOT);
+        StringBuilder sb = new StringBuilder(lower.length());
+        int len = lower.length();
+        int i = 0;
+
+        while (i < len) {
+            // "shch" before "sch", both before the two-letter "sh"
+            if (lower.startsWith("shch", i) || lower.startsWith("sch", i)) {
+                sb.append('щ');
+                i += lower.startsWith("shch", i) ? 4 : 3;
+                continue;
+            }
+
+            char c = lower.charAt(i);
+            char next = i + 1 < len ? lower.charAt(i + 1) : 0;
+            boolean atWordEnd = i + 2 == len;
+
+            // Iotated vowels: "ya", "ju", "yo", "ye"
+            if ((c == 'y' || c == 'j') && isIotatable(next)) {
+                if (softSign && i > 0 && isConsonant(lower.charAt(i - 1))) sb.append('ь');
+                sb.append(switch (next) {
+                    case 'a' -> 'я';
+                    case 'u' -> 'ю';
+                    case 'o' -> 'ё';
+                    default -> 'е';
+                });
+                i += 2;
+                continue;
+            }
+
+            String twoMapped = switch (c) {
+                case 'z' -> next == 'h' ? "ж" : null;
+                case 'k' -> next == 'h' ? "х" : null;
+                case 'c' -> next == 'h' ? "ч" : null;
+                case 's' -> next == 'h' ? "ш" : null;
+                // "tsh" is "т" + the digraph "sh" ("Otshel'nik" -> "Отшельник")
+                case 't' -> next == 's' && (i + 2 >= len || lower.charAt(i + 2) != 'h') ? "ц" : null;
+                // Word-final "ia"/"ii" as in "Maria", "Rossia", passport-style "Iurii"
+                case 'i' -> atWordEnd && next == 'a' ? "ия" : atWordEnd && next == 'i' ? "ий" : null;
+                default -> null;
+            };
+            if (twoMapped != null) {
+                sb.append(twoMapped);
+                i += 2;
+                continue;
+            }
+
+            char prev = i > 0 ? lower.charAt(i - 1) : 0;
+            switch (c) {
+                case 'a' -> sb.append('а');
+                case 'b' -> sb.append('б');
+                case 'v', 'w' -> sb.append('в');
+                case 'g' -> sb.append('г');
+                case 'd' -> sb.append('д');
+                case 'e' -> sb.append(i == 0 ? 'э' : 'е');
+                case 'z' -> sb.append('з');
+                case 'i' -> sb.append('и');
+                case 'j' -> sb.append('й');
+                case 'k', 'q' -> sb.append('к');
+                case 'l' -> sb.append('л');
+                case 'm' -> sb.append('м');
+                case 'n' -> sb.append('н');
+                case 'o' -> sb.append('о');
+                case 'p' -> sb.append('п');
+                case 'r' -> sb.append('р');
+                case 's' -> sb.append('с');
+                case 't' -> sb.append('т');
+                case 'u' -> sb.append('у');
+                case 'f' -> sb.append('ф');
+                case 'h' -> sb.append('х');
+                case 'x' -> sb.append("кс");
+                case '\'' -> sb.append('ь');
+                case 'c' -> sb.append(next == 'e' || next == 'i' || next == 'y' ? 'ц' : 'к');
+                case 'y' -> sb.append(isVowel(prev) ? 'й' : 'ы');
+                default -> sb.append(c);
+            }
+            i++;
+        }
+
+        return applyCase(sb.toString(), allUpper, firstUpper);
+    }
+
+    private static boolean isVowel(char c) {
+        return c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' || c == 'y';
+    }
+
+    private static boolean isConsonant(char c) {
+        return c >= 'a' && c <= 'z' && !isVowel(c);
+    }
+
+    private static boolean isIotatable(char c) {
+        return c == 'a' || c == 'u' || c == 'o' || c == 'e';
+    }
+
+    private static String applyCase(String cyrillic, boolean allUpper, boolean firstUpper) {
+        if (cyrillic.isEmpty()) return cyrillic;
+        if (allUpper) {
+            return cyrillic.toUpperCase(Locale.ROOT);
+        }
+        if (firstUpper) {
+            return Character.toUpperCase(cyrillic.charAt(0)) + cyrillic.substring(1);
+        }
+        return cyrillic;
+    }
+
+    private static boolean isAllUpperCase(String s) {
+        boolean hasLetter = false;
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (Character.isLetter(c)) {
+                hasLetter = true;
+                if (!Character.isUpperCase(c)) return false;
+            }
+        }
+        return hasLetter;
+    }
+}
