+        assertEquals("Место встречи изменить нелзя", TransliterateUtils.transliterateToCyrillic("Mesto vstrechi izmenit' nelzya"));
+        assertEquals("Место встречи изменит нелзя", TransliterateUtils.transliterateToCyrillic("Mesto vstrechi izmenit nelzya"));
+
+        // More test cases
