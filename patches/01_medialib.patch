+            return Collections.emptyList();
+        }
+
+        String part1 = null;
+        String part2 = null;
+
+        if (lastCyr < firstLat) {
+            // Cyrillic title first, Latin title second (e.g. "Назад в будущее Back to the Future", "Брат 2 Brother 2")
+            part1 = input.substring(0, firstLat).trim();
+            part2 = input.substring(firstLat).trim();
+        } else if (lastLat < firstCyr) {
+            // Latin title first, Cyrillic title second (e.g. "Back to the Future Назад в будущее", "Brother 2 Брат 2")
+            part1 = input.substring(0, firstCyr).trim();
+            part2 = input.substring(firstCyr).trim();
+        } else {
