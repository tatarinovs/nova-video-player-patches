+package com.archos.mediacenter.utils.videodb;
+
+import android.content.Context;
+import android.net.Uri;
+
+import androidx.test.core.app.ApplicationProvider;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+
+import static org.junit.Assert.assertEquals;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk = 33)
+public class ExternalBookmarksTest {
+
+    private static final Uri TORRSERVE = Uri.parse("http://192.168.1.10:8090/stream/Show.S01E02.mkv?link=ABCDEF&index=2&play");
+    private static final Uri TORRSERVE_OTHER_HOST = Uri.parse("http://127.0.0.1:8090/stream/Show.S01E02.mkv?link=abcdef&index=2");
+
+    private Context context;
+
+    @Before
+    public void setUp() {
+        context = ApplicationProvider.getApplicationContext();
+        context.getSharedPreferences("external_bookmarks", Context.MODE_PRIVATE).edit().clear().commit();
+    }
+
+    @Test
+    public void torrServeKeyIgnoresHostAndTransientParameters() {
+        assertEquals("torrserve:abcdef:2", ExternalBookmarks.getBookmarkKey(TORRSERVE));
+        assertEquals(ExternalBookmarks.getBookmarkKey(TORRSERVE), ExternalBookmarks.getBookmarkKey(TORRSERVE_OTHER_HOST));
+    }
+
+    @Test
+    public void normalizeUriDropsTransientParametersAndSortsTheRest() {
+        assertEquals("http://host/video.mkv?a=1&b=2",
+                ExternalBookmarks.normalizeUri(Uri.parse("http://host/video.mkv?b=2&play&a=1&preload=1")));
+    }
+
+    @Test
+    public void saveThenLoadAcrossHosts() {
+        ExternalBookmarks.saveBookmark(context, TORRSERVE, 120_000, 3_600_000, 1_700_000_000L);
+        assertEquals(120_000, ExternalBookmarks.getBookmark(context, TORRSERVE_OTHER_HOST));
+
+        VideoDbInfo info = new VideoDbInfo(TORRSERVE_OTHER_HOST);
+        info.duration = 0;
+        ExternalBookmarks.loadBookmark(context, info);
+        assertEquals(120_000, info.resume);
+        assertEquals(3_600_000, info.duration);
+        assertEquals(1_700_000_000L, info.lastTimePlayed);
+    }
+
+    @Test
+    public void finishedOrBarelyStartedVideoClearsBookmark() {
+        ExternalBookmarks.saveBookmark(context, TORRSERVE, 120_000, 3_600_000, 0);
+        ExternalBookmarks.saveBookmark(context, TORRSERVE, 3_595_000, 3_600_000, 0);
+        assertEquals(0, ExternalBookmarks.getBookmark(context, TORRSERVE));
+
+        ExternalBookmarks.saveBookmark(context, TORRSERVE, 120_000, 3_600_000, 0);
+        ExternalBookmarks.saveBookmark(context, TORRSERVE, ExternalBookmarks.LAST_POSITION_END, 3_600_000, 0);
+        assertEquals(0, ExternalBookmarks.getBookmark(context, TORRSERVE));
+    }
+
+    @Test
+    public void unknownPositionKeepsExistingBookmark() {
+        ExternalBookmarks.saveBookmark(context, TORRSERVE, 120_000, 3_600_000, 0);
+        ExternalBookmarks.saveBookmark(context, TORRSERVE, ExternalBookmarks.LAST_POSITION_UNKNOWN, 3_600_000, 0);
+        assertEquals(120_000, ExternalBookmarks.getBookmark(context, TORRSERVE));
+    }
+
+    @Test
+    public void legacyRawUriKeyIsReadAndMigrated() {
+        context.getSharedPreferences("external_bookmarks", Context.MODE_PRIVATE).edit()
+                .putInt(TORRSERVE.toString() + "_pos", 60_000).commit();
+        assertEquals(60_000, ExternalBookmarks.getBookmark(context, TORRSERVE));
+
+        ExternalBookmarks.saveBookmark(context, TORRSERVE, 90_000, 0, 0);
+        assertEquals(0, context.getSharedPreferences("external_bookmarks", Context.MODE_PRIVATE)
+                .getInt(TORRSERVE.toString() + "_pos", 0));
+        assertEquals(90_000, ExternalBookmarks.getBookmark(context, TORRSERVE));
+    }
+}
