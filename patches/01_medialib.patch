+package com.archos.mediacenter.utils.videodb;
+
+import android.net.Uri;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk = 33)
+public class StreamTitleResolverTest {
+
+    private static final String TOPIC = "[NUM] Звездный путь: Странные новые миры (4 сезон: 1-10 серия из 10)"
+            + " / Star Trek: Strange New Worlds / 2026 / ПМ (NewComers), СТ / WEB-DL (1080p) | NewComers";
+
+    @Test
+    public void sourceTitleIsShownAsIsWithTheEpisodeNumber() {
+        Uri uri = Uri.parse("http://127.0.0.1:8090/stream/Star.Trek.Strange.New.Worlds.S04E07.1080p.WEB-DL.NewComers.mkv?link=aa73&index=7&play");
+        StreamTitleResolver.Result res = StreamTitleResolver.resolve(uri, TOPIC);
+        assertTrue(res.isTvShow);
+        assertEquals(4, res.season);
+        assertEquals(7, res.episode);
+        String shown = TOPIC.substring("[NUM] ".length()); // leading tags are dropped
+        assertEquals(shown, res.showName);
+        assertEquals(shown + "  -  S04E07", res.title);
+    }
+
+    @Test
+    public void onlyLeadingTagsAreDropped() {
+        Uri uri = Uri.parse("http://127.0.0.1:8090/stream/Movie.mkv?link=ab&index=1&play");
+        assertEquals("Начало / Inception [2010, BDRip]",
+                StreamTitleResolver.resolve(uri, "[NUM] [HD] Начало / Inception [2010, BDRip]").title);
+        // A title made only of a tag falls back to the file name
+        assertEquals("Movie", StreamTitleResolver.resolve(uri, "[NUM]").title);
+    }
+
+    @Test
+    public void episodeNumberIsNotRepeated() {
+        Uri uri = Uri.parse("http://127.0.0.1:8090/stream/Show.S01E02.mkv?link=ab&index=2&play");
+        assertEquals("Show - S01E02 - Pilot", StreamTitleResolver.resolve(uri, "Show - S01E02 - Pilot").title);
+        assertEquals("Show - s01e02", StreamTitleResolver.resolve(uri, "Show - s01e02").title);
+    }
+
+    @Test
+    public void movieOrUnknownFileKeepsTheSourceTitle() {
+        Uri uri = Uri.parse("http://127.0.0.1:8090/stream/Inception.2010.1080p.mkv?link=ab&index=1&play");
+        StreamTitleResolver.Result res = StreamTitleResolver.resolve(uri, "Начало / Inception [2010, BDRip]");
+        assertFalse(res.isTvShow);
+        assertEquals("Начало / Inception [2010, BDRip]", res.title);
+    }
+
+    @Test
+    public void withoutSourceTitleTheFileNameIsUsed() {
+        Uri uri = Uri.parse("http://127.0.0.1:8090/stream/Breaking.Bad.S01E03.720p.mkv?link=ab&index=3&play");
+        assertEquals("Breaking.Bad.S01E03.720p", StreamTitleResolver.resolve(uri, null).title);
+        assertEquals("Video", StreamTitleResolver.resolve(Uri.parse("http://host/stream?link=ab&index=0"), " ").title);
+    }
+
+    @Test
+    public void extractFileName() {
+        assertEquals("Breaking.Bad.s01e03.720p", StreamTitleResolver.extractFileName(
+                Uri.parse("http://127.0.0.1:8090/stream/Breaking.Bad.s01e03.720p.mkv?link=45b6&index=2&play")));
+        assertEquals("Серия 04", StreamTitleResolver.extractFileName(
+                Uri.parse("http://127.0.0.1:8090/stream/%D0%A1%D0%B5%D1%80%D0%B8%D1%8F%2004.mkv?link=a")));
+        assertEquals("Episode", StreamTitleResolver.extractFileName(
+                Uri.parse("http://host/stream/Season%201%2FEpisode.mkv?link=a")));
+        assertEquals("Show.S02E05", StreamTitleResolver.extractFileName(
+                Uri.parse("http://127.0.0.1:8090/stream?link=abcdef&index=0&play&title=Show.S02E05.mkv")));
+        assertEquals("Mr. Robot", StreamTitleResolver.extractFileName(Uri.parse("http://host/Mr.%20Robot")));
+        assertNull(StreamTitleResolver.extractFileName(Uri.parse("http://host/stream?link=abcdef")));
+    }
+}
