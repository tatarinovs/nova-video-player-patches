+    @Test
+    public void testTransliterateContextRules() {
+        // 'y' before a vowel is iotation, not "й" + vowel
+        assertEquals("Моя прекрасная няня", TransliterateUtils.transliterateToCyrillic("Moya prekrasnaya nyanya"));
+        assertEquals("Маяк", TransliterateUtils.transliterateToCyrillic("Mayak"));
+        assertEquals("Своя", TransliterateUtils.transliterateToCyrillic("Svoya"));
+        // 'y' after a vowel is "й", after a consonant "ы"
+        assertEquals("Красный", TransliterateUtils.transliterateToCyrillic("Krasnyy"));
+        // Word-initial 'e' is "э"
+        assertEquals("Экипаж", TransliterateUtils.transliterateToCyrillic("Ekipazh"));
+        // Word-final "ia" is "ия", elsewhere "иа"
+        assertEquals("Мария", TransliterateUtils.transliterateToCyrillic("Maria"));
+        assertEquals("Диана", TransliterateUtils.transliterateToCyrillic("Diana"));
+        // Only "ts" is "ц": "t" followed by "c", "ch", "sh" or "z" keeps its own letter
+        assertEquals("Отчаяние", TransliterateUtils.transliterateToCyrillic("Otchayanie"));
+        assertEquals("Отцы", TransliterateUtils.transliterateToCyrillic("Ottsy"));
+        assertEquals("Отшельник", TransliterateUtils.transliterateToCyrillic("Otshel'nik"));
+        assertEquals("Отзыв", TransliterateUtils.transliterateToCyrillic("Otzyv"));
+        assertEquals("Безшумный", TransliterateUtils.transliterateToCyrillic("Bezshumnyy"));
+        assertEquals("Джентльмены удачи", TransliterateUtils.transliterateToCyrillic("Dzhentl'meny udachi"));
+        // "sch" is "щ" like "shch"
+        assertEquals("Борщ", TransliterateUtils.transliterateToCyrillic("Borsch"));
+        assertEquals("Щука", TransliterateUtils.transliterateToCyrillic("Schuka"));
+        // Non-Latin text is left alone
+        assertEquals("Брат 2", TransliterateUtils.transliterateToCyrillic("Брат 2"));
+    }
