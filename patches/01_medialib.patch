+package com.archos.mediacenter.utils.videodb;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.net.Uri;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Persistent bookmark store for external and unindexed video streams (TorrServe Matrix,
+ * AceStream, arbitrary HTTP/HTTPS URLs) which are not in the media store (videoInfo.id == -1).
+ */
+public final class ExternalBookmarks {
+
+    private static final Logger log = LoggerFactory.getLogger(ExternalBookmarks.class);
+
+    private static final String PREF_NAME = "external_bookmarks";
+    private static final String KEY_POSTFIX_POS = "_pos";
+    private static final String KEY_POSTFIX_DUR = "_dur";
+    private static final String KEY_POSTFIX_TIME = "_time";
+
+    public static final int LAST_POSITION_END = -2;
+    public static final int LAST_POSITION_UNKNOWN = -1;
+    private static final int MIN_RESUME_POSITION_MS = 3000;
+    private static final int END_OFFSET_MS = 10000;
+    private static final int MAX_STORED_BOOKMARKS = 500;
+
+    /** Query parameters which change between launches of the same stream. */
+    private static final Set<String> TRANSIENT_QUERY_PARAMETERS = new HashSet<>(Arrays.asList("play", "preload", "stat", "from", "time", "save"));
+
+    private ExternalBookmarks() {
+    }
+
+    private static final class Bookmark {
+        final int position;
+        final int duration;
+        final long lastTimePlayed;
+
+        Bookmark(int position, int duration, long lastTimePlayed) {
+            this.position = position;
+            this.duration = duration;
+            this.lastTimePlayed = lastTimePlayed;
+        }
+    }
+
+    /**
+     * Canonical storage key for a stream URI. TorrServe-like URLs are keyed by torrent
+     * link/hash and file index so that bookmarks survive changes of host, port or transient
+     * query parameters (like "&play").
+     */
+    public static String getBookmarkKey(Uri uri) {
+        if (uri == null) return null;
+        try {
+            if (uri.isHierarchical()) {
+                String link = firstQueryParameter(uri, "link", "hash", "ih");
+                if (link != null) {
+                    String index = firstQueryParameter(uri, "index", "file", "id");
+                    if (index == null) index = uri.getLastPathSegment();
+                    if (index == null) index = "0";
+                    return "torrserve:" + link.toLowerCase(Locale.ROOT) + ":" + index;
+                }
+                String infohash = firstQueryParameter(uri, "infohash");
+                if (infohash != null) {
+                    return "acestream:" + infohash.toLowerCase(Locale.ROOT);
+                }
+            }
+        } catch (Exception e) {
+            log.warn("getBookmarkKey: error parsing uri {}", uri, e);
+        }
+        return normalizeUri(uri);
+    }
+
+    /**
+     * Strips transient query parameters and sorts the remaining ones to produce a stable key.
+     */
+    public static String normalizeUri(Uri uri) {
+        if (uri == null) return null;
+        try {
+            if (!uri.isHierarchical()) {
+                return uri.toString();
+            }
+            Set<String> paramNames = uri.getQueryParameterNames();
+            if (paramNames.isEmpty()) {
+                return uri.toString();
+            }
+            List<String> kept = new ArrayList<>();
+            for (String param : paramNames) {
+                if (!TRANSIENT_QUERY_PARAMETERS.contains(param.toLowerCase(Locale.ROOT))) {
+                    kept.add(param);
+                }
+            }
+            Collections.sort(kept);
+            Uri.Builder builder = uri.buildUpon().clearQuery();
+            for (String param : kept) {
+                for (String value : uri.getQueryParameters(param)) {
+                    builder.appendQueryParameter(param, value);
+                }
+            }
+            return builder.build().toString();
+        } catch (Exception e) {
+            return uri.toString();
+        }
+    }
+
+    /**
+     * Saves position, duration and timestamp of an unindexed video.
+     */
+    public static void saveBookmark(Context context, VideoDbInfo videoInfo) {
+        if (context == null || videoInfo == null || videoInfo.uri == null) return;
+        saveBookmark(context, videoInfo.uri, videoInfo.resume, videoInfo.duration, videoInfo.lastTimePlayed);
+    }
+
+    /**
+     * Saves position, duration and timestamp for a stream URI. A finished video (or one barely
+     * started) clears its bookmark instead.
+     */
+    public static void saveBookmark(Context context, Uri uri, int position, int duration, long lastTimePlayed) {
+        if (context == null || uri == null) return;
+        Set<String> keys = candidateKeys(uri);
+        if (keys.isEmpty()) return;
+        String key = keys.iterator().next();
+
+        SharedPreferences prefs = prefs(context);
+        SharedPreferences.Editor editor = prefs.edit();
+        // Legacy/alternative keys are always dropped: the canonical key is the single source of truth
+        for (String k : keys) {
+            if (!k.equals(key)) remove(editor, k);
+        }
+
+        boolean finished = position == LAST_POSITION_END
+                || (duration > 0 && position >= duration - END_OFFSET_MS)
+                || (position != LAST_POSITION_UNKNOWN && position <= MIN_RESUME_POSITION_MS);
+        if (finished) {
+            if (log.isDebugEnabled()) log.debug("saveBookmark: clearing bookmark for key={}", key);
+            remove(editor, key);
+            editor.apply();
+            return;
+        }
+        if (position <= MIN_RESUME_POSITION_MS) { // unknown position: keep what we had
+            editor.apply();
+            return;
+        }
+
+        long timestamp = lastTimePlayed > 0 ? lastTimePlayed : System.currentTimeMillis() / 1000L;
+        if (log.isDebugEnabled()) log.debug("saveBookmark: saving pos={} dur={} for key={}", position, duration, key);
+        editor.putInt(key + KEY_POSTFIX_POS, position);
+        if (duration > 0) {
+            editor.putInt(key + KEY_POSTFIX_DUR, duration);
+        }
+        editor.putLong(key + KEY_POSTFIX_TIME, timestamp);
+        editor.apply();
+
+        trimOldBookmarksIfNeeded(prefs);
+    }
+
+    /**
+     * Returns the saved resume position in milliseconds, or 0 if none.
+     */
+    public static int getBookmark(Context context, Uri uri) {
+        if (context == null || uri == null) return 0;
+        Bookmark bookmark = find(prefs(context), uri);
+        return bookmark != null ? bookmark.position : 0;
+    }
+
+    /**
+     * Loads the saved bookmark into an unindexed VideoDbInfo.
+     *
+     * @return true if a bookmark was found
+     */
+    public static boolean loadBookmark(Context context, VideoDbInfo videoInfo) {
+        if (context == null || videoInfo == null || videoInfo.uri == null) return false;
+        Bookmark bookmark = find(prefs(context), videoInfo.uri);
+        if (bookmark == null) return false;
+
+        videoInfo.resume = bookmark.position;
+        videoInfo.lastTimePlayed = bookmark.lastTimePlayed > 0 ? bookmark.lastTimePlayed : System.currentTimeMillis() / 1000L;
+        if (bookmark.duration > 0 && videoInfo.duration <= 0) {
+            videoInfo.duration = bookmark.duration;
+        }
+        if (log.isDebugEnabled()) log.debug("loadBookmark: resume={} duration={} for uri={}", bookmark.position, bookmark.duration, videoInfo.uri);
+        return true;
+    }
+
+    private static Bookmark find(SharedPreferences prefs, Uri uri) {
+        for (String key : candidateKeys(uri)) {
+            int position = prefs.getInt(key + KEY_POSTFIX_POS, 0);
+            if (position > MIN_RESUME_POSITION_MS) {
+                return new Bookmark(position, prefs.getInt(key + KEY_POSTFIX_DUR, 0), prefs.getLong(key + KEY_POSTFIX_TIME, 0));
+            }
+        }
+        return null;
+    }
+
+    /** Canonical key first, then the forms used by earlier versions. */
+    private static Set<String> candidateKeys(Uri uri) {
+        Set<String> keys = new LinkedHashSet<>(3);
+        addIfNotNull(keys, getBookmarkKey(uri));
+        addIfNotNull(keys, normalizeUri(uri));
+        addIfNotNull(keys, uri.toString());
+        return keys;
+    }
+
+    private static void trimOldBookmarksIfNeeded(SharedPreferences prefs) {
+        Map<String, ?> all = prefs.getAll();
+        if (all.size() <= MAX_STORED_BOOKMARKS * 3) return;
+        try {
+            List<String> timeKeys = new ArrayList<>();
+            for (String k : all.keySet()) {
+                if (k.endsWith(KEY_POSTFIX_TIME)) timeKeys.add(k);
+            }
+            if (timeKeys.size() <= MAX_STORED_BOOKMARKS) return;
+            Collections.sort(timeKeys, (k1, k2) -> Long.compare(asLong(all.get(k1)), asLong(all.get(k2))));
+            SharedPreferences.Editor editor = prefs.edit();
+            int removeCount = timeKeys.size() - MAX_STORED_BOOKMARKS;
+            for (int i = 0; i < removeCount; i++) {
+                String timeKey = timeKeys.get(i);
+                remove(editor, timeKey.substring(0, timeKey.length() - KEY_POSTFIX_TIME.length()));
+            }
+            editor.apply();
+        } catch (Exception e) {
+            log.warn("trimOldBookmarksIfNeeded: error pruning", e);
+        }
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getSharedPreferences(PREF_NAME, Context.MODE_PRIVATE);
+    }
+
+    private static void remove(SharedPreferences.Editor editor, String key) {
+        editor.remove(key + KEY_POSTFIX_POS);
+        editor.remove(key + KEY_POSTFIX_DUR);
+        editor.remove(key + KEY_POSTFIX_TIME);
+    }
+
+    private static String firstQueryParameter(Uri uri, String... names) {
+        for (String name : names) {
+            String value = uri.getQueryParameter(name);
+            if (value != null && !value.isEmpty()) return value;
+        }
+        return null;
+    }
+
+    private static void addIfNotNull(Set<String> set, String value) {
+        if (value != null) set.add(value);
+    }
+
+    private static long asLong(Object value) {
+        return value instanceof Long ? (Long) value : 0L;
+    }
+}
