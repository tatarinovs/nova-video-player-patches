+        // Strip any dangling punctuation/separators at borders (like " - ", " / ")
+        part1 = part1.replaceAll("[\\s\\p{Punct}&&[^']]+$", "").trim();
+        part2 = part2.replaceAll("^[\\s\\p{Punct}&&[^']]+", "").trim();
