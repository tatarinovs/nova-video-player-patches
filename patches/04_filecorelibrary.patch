+package com.archos.filecorelibrary;
+
+import static org.junit.Assert.assertEquals;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk = 28)
+public class FileUtilsNameTest {
+
+    @Test
+    public void httpStreamNamesDropQueryAndFragment() {
+        assertEquals("video.mkv", FileUtils.getName("http://127.0.0.1:8090/stream/video.mkv?link=abc.def&index=1&play"));
+        assertEquals("video.mkv", FileUtils.getName("https://host/video.mkv#t=10"));
+        assertEquals("stream", FileUtils.getName("http://host/stream?link=magnet:?xt=urn:btih:abc/def&index=0"));
+        assertEquals("video", FileUtils.stripExtensionFromName("video.mkv?play"));
+        assertEquals("video", FileUtils.stripExtensionFromName("video.mkv?link=a.b"));
+    }
+
+    @Test
+    public void localNamesKeepQuestionMarksAndHashes() {
+        assertEquals("What?.mkv", FileUtils.getName("/storage/emulated/0/Movies/What?.mkv"));
+        assertEquals("#Alive.mkv", FileUtils.getName("smb://server/share/#Alive.mkv"));
+        assertEquals("What?", FileUtils.stripExtensionFromName("What?.mkv"));
+        assertEquals("Кто я?", FileUtils.stripExtensionFromName("Кто я?"));
+    }
+
+    @Test
+    public void dottedLocalNamesKeepQuestionMarksAndHashes() {
+        assertEquals("What.If?.2021.mkv", FileUtils.getName("/storage/emulated/0/Movies/What.If?.2021.mkv"));
+        assertEquals("Who.Is.Who?.mkv", FileUtils.getName("smb://server/share/Who.Is.Who?.mkv"));
+        assertEquals("The.Avi#1.mkv", FileUtils.getName("/storage/emulated/0/Movies/The.Avi#1.mkv"));
+        assertEquals("What.If?.2021", FileUtils.stripExtensionFromName("What.If?.2021.mkv"));
+    }
+}
