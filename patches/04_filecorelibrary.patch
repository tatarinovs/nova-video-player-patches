+    private static final Pattern HTTP_URL = Pattern.compile("^https?://.*", Pattern.CASE_INSENSITIVE);
+    private static final String MEDIA_EXTENSIONS =
+            "(?:mkv|mp4|m4v|avi|mov|wmv|webm|flv|ts|m2ts|mts|mpg|mpeg|vob|iso|3gp|ogv|divx|rmvb|m3u8?)";
+    private static final Pattern URL_SUFFIX_AFTER_EXTENSION = Pattern.compile(
+            "(?<=\\." + MEDIA_EXTENSIONS + ")[?#].*$", Pattern.CASE_INSENSITIVE);
+    private static final Pattern ENDS_WITH_MEDIA_EXTENSION = Pattern.compile(
+            "\\." + MEDIA_EXTENSIONS + "$", Pattern.CASE_INSENSITIVE);
+
+    /**
+     * Removes what cannot belong to a file name from streaming references: the query and fragment
+     * of an HTTP(S) URL ("http://host/stream/video.mkv?link=...&play"), or a "?..."/"#..." suffix
+     * directly following a media extension ("video.mkv?play"). Other '?' and '#' characters are
+     * legitimate in local or SMB file names ("What?.mkv", "What.If?.2021.mkv") and are preserved:
+     * a name which itself ends with a media extension is never cut.
+     */
+    public static String stripUrlQueryAndFragment(String name) {
+        if (name == null) return null;
+        if (HTTP_URL.matcher(name).matches()) {
+            int end = name.length();
+            int q = name.indexOf('?');
+            if (q >= 0) end = q;
+            int hash = name.indexOf('#');
+            if (hash >= 0 && hash < end) end = hash;
+            return name.substring(0, end);
+        }
+        if (ENDS_WITH_MEDIA_EXTENSION.matcher(name).find()) return name;
+        return URL_SUFFIX_AFTER_EXTENSION.matcher(name).replaceFirst("");
+    }
